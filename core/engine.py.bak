"""
核心修复引擎 - 基于LaMa深度学习模型的图像/视频修复
支持CUDA和CPU推理，自动检测可用设备
"""
import os
import sys
import time
import logging
import numpy as np
from PIL import Image
from pathlib import Path
from typing import Optional, Tuple, List, Union
import torch
import cv2
# 设置日志
LOG_DIR = Path(r"D:\AI\watermark_remover\logs")
LOG_DIR.mkdir(parents=True, exist_ok=True)
file_handler = logging.FileHandler(LOG_DIR / 'engine.log', encoding='utf-8')
file_handler.setFormatter(logging.Formatter('%(asctime)s [%(levelname)s] %(message)s'))
console_handler = logging.StreamHandler(sys.stdout)
console_handler.setFormatter(logging.Formatter('%(asctime)s [%(levelname)s] %(message)s'))
logging.basicConfig(
    level=logging.INFO,
    handlers=[file_handler, console_handler]
)
logger = logging.getLogger(__name__)
# 模型和缓存目录
MODEL_DIR = Path(r"D:\AI\watermark_remover\models")
CACHE_DIR = Path(r"D:\AI\watermark_remover\cache")
OUTPUT_DIR = Path(r"D:\AI\watermark_remover\output")
for d in [MODEL_DIR, CACHE_DIR, OUTPUT_DIR]:
    d.mkdir(parents=True, exist_ok=True)
class InpaintingEngine:
    """图像修复引擎 - 使用LaMa模型进行高质量水印去除"""
    def __init__(self, device: str = 'auto'):
        self.device = self._get_device(device)
        self.model = None
        self.model_loaded = False
        logger.info(f"Engine initialized on device: {self.device}")
    def _get_device(self, device: str) -> torch.device:
        """自动检测并返回最佳设备"""
        if device == 'auto':
            if torch.cuda.is_available():
                gpu_name = torch.cuda.get_device_name(0)
                try:
                    gpu_mem = torch.cuda.get_device_properties(0).total_memory / 1024**3
                except AttributeError:
                    gpu_mem = torch.cuda.get_device_properties(0).total_mem / 1024**3
                logger.info(f"[GPU] {gpu_name} ({gpu_mem:.1f}GB) - CUDA enabled")
                try:
                    dummy = torch.zeros(1).cuda()
                    torch.cuda.synchronize()
                    del dummy
                except Exception:
                    pass
                return torch.device('cuda')
            else:
                logger.info("[CPU] CUDA not available, using CPU mode")
                return torch.device('cpu')
        return torch.device(device)
    def load_model(self, force_download: bool = False) -> bool:
        """加载LaMa修复模型"""
        try:
            logger.info("Loading LaMa inpainting model...")
            from simple_lama_inpainting import SimpleLama
            self.model = SimpleLama(device=self.device)
            self.model_loaded = True
            logger.info("[OK] LaMa model loaded successfully")
            return True
        except Exception as e:
            logger.error(f"[FAIL] LaMa model load error: {e}")
            return False
    def _ensure_model_loaded(self):
        if not self.model_loaded:
            if not self.load_model():
                raise RuntimeError("Cannot load inpainting model. Check network or model files.")
    def _load_image(self, image_path: str) -> np.ndarray:
        """加载图像，支持中文路径"""
        try:
            img = Image.open(image_path).convert('RGB')
            return np.array(img)
        except Exception as e:
            logger.warning(f"PIL load failed, trying cv2: {e}")
            with open(image_path, 'rb') as f:
                data = np.frombuffer(f.read(), np.uint8)
            img = cv2.imdecode(data, cv2.IMREAD_COLOR)
            if img is None:
                raise ValueError(f"Cannot read image: {image_path}")
            return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    def _save_image(self, image: np.ndarray, save_path: str):
        """保存图像，支持中文路径"""
        if len(image.shape) == 2:
            image = cv2.cvtColor(image, cv2.COLOR_GRAY2RGB)
        elif image.shape[2] == 4:
            image = image[:, :, :3]
        # 确保是uint8且值域正确
        image = np.clip(image, 0, 255).astype(np.uint8)
        # 使用cv2保存，避免PIL的RGB/BGR问题
        ext = Path(save_path).suffix.lower()
        if ext in ['.jpg', '.jpeg']:
            cv2.imwrite(save_path, cv2.cvtColor(image, cv2.COLOR_RGB2BGR),
                        [cv2.IMWRITE_JPEG_QUALITY, 95])
        else:
            cv2.imwrite(save_path, cv2.cvtColor(image, cv2.COLOR_RGB2BGR))
    def _create_mask_from_bbox(self, image_shape: Tuple[int, int],
                                 bbox: Tuple[int, int, int, int],
                                 feather: int = 5) -> np.ndarray:
        """从边界框创建mask（二值硬mask，避免灰色过渡带）"""
        h, w = image_shape[:2]
        mask = np.zeros((h, w), dtype=np.uint8)
        x1, y1, x2, y2 = bbox
        x1 = max(0, min(int(x1), w - 1))
        y1 = max(0, min(int(y1), h - 1))
        x2 = max(x1 + 1, min(int(x2), w))
        y2 = max(y1 + 1, min(int(y2), h))
        mask[y1:y2, x1:x2] = 255
        # 轻微膨胀，确保覆盖水印边缘，但保持二值mask
        if feather > 0:
            kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (feather * 2 + 1, feather * 2 + 1))
            mask = cv2.dilate(mask, kernel, iterations=1)
            # 二值化，确保只有0和255，不产生灰色过渡带
            _, mask = cv2.threshold(mask, 30, 255, cv2.THRESH_BINARY)
        return mask
    def _merge_regions(self, regions: List[Tuple[int, int, int, int]],
                       w: int, h: int) -> List[Tuple[int, int, int, int]]:
        """合并重叠或相邻的区域"""
        if not regions:
            return []
        regions = sorted(regions)
        merged = []
        for r in regions:
            if not merged:
                merged.append(list(r))
                continue
            last = merged[-1]
            x1, y1, x2, y2 = r
            lx1, ly1, lx2, ly2 = last
            overlap = not (x2 < lx1 or x1 > lx2 or y2 < ly1 or y1 > ly2)
            if overlap:
                last[0] = min(lx1, x1)
                last[1] = min(ly1, y1)
                last[2] = max(lx2, x2)
                last[3] = max(ly2, y2)
            else:
                merged.append(list(r))
        return [tuple(r) for r in merged]
    def _detect_watermark_auto(self, image: np.ndarray) -> List[Tuple[int, int, int, int]]:
        """
        自动检测水印区域 - 精准版
        只检测真正的文字/LOGO水印，避免误伤正常画面
        """
        h, w = image.shape[:2]
        gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
        regions = []
        # ========== 1. 检测底部文字水印 ==========
        bottom_h = int(h * 0.12)
        bottom_region = gray[h - bottom_h:, :]
        # 检测亮色文字和暗色文字
        for thresh_mode in [cv2.THRESH_BINARY, cv2.THRESH_BINARY_INV]:
            _, binary = cv2.threshold(bottom_region, 0, 255, thresh_mode + cv2.THRESH_OTSU)
            # 形态学连接文字
            kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (15, 5))
            closed = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)
            contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for cnt in contours:
                area = cv2.contourArea(cnt)
                x, y, bw, bh = cv2.boundingRect(cnt)
                # 过滤：水印文字通常宽高比在0.5-5之间，且不会太大
                if area < 50 or bw < 20 or bh < 8:
                    continue
                # 限制区域大小：不超过画面的15%
                if bw * bh > w * h * 0.15:
                    continue
                # 文字通常宽度>高度
                if bh > bw * 3:
                    continue
                # 添加适度padding
                pad_w = int(bw * 0.3) + 10
                pad_h = int(bh * 0.8) + 5
                x1 = max(0, x - pad_w)
                y1 = max(0, h - bottom_h + y - pad_h)
                x2 = min(w, x + bw + pad_w)
                y2 = min(h, h - bottom_h + y + bh + pad_h)
                regions.append((x1, y1, x2, y2))
        # ========== 2. 检测四角LOGO水印 ==========
        corner_size_w = int(w * 0.25)
        corner_size_h = int(h * 0.25)
        corners = [
            (0, 0, corner_size_w, corner_size_h),          # 左上
            (w - corner_size_w, 0, w, corner_size_h),      # 右上
            (0, h - corner_size_h, corner_size_w, h),      # 左下
            (w - corner_size_w, h - corner_size_h, w, h),  # 右下
        ]
        for cx1, cy1, cx2, cy2 in corners:
            corner = gray[cy1:cy2, cx1:cx2]
            if corner.size == 0:
                continue
            # 检测角落区域的文字/LOGO（高对比度小区域）
            _, corner_binary = cv2.threshold(corner, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
            kernel2 = cv2.getStructuringElement(cv2.MORPH_RECT, (10, 5))
            corner_closed = cv2.morphologyEx(corner_binary, cv2.MORPH_CLOSE, kernel2)
            corner_contours, _ = cv2.findContours(corner_closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for cnt in corner_contours:
                area = cv2.contourArea(cnt)
                x, y, bw, bh = cv2.boundingRect(cnt)
                # 过滤小噪点
                if area < 80 or bw < 25 or bh < 10:
                    continue
                # 限制大小：角落水印不会超过角落区域的40%
                if bw * bh > corner_size_w * corner_size_h * 0.4:
                    continue
                # 添加padding
                pad_w = int(bw * 0.3) + 8
                pad_h = int(bh * 0.5) + 5
                x1 = max(0, cx1 + x - pad_w)
                y1 = max(0, cy1 + y - pad_h)
                x2 = min(w, cx1 + x + bw + pad_w)
                y2 = min(h, cy1 + y + bh + pad_h)
                regions.append((x1, y1, x2, y2))
        # ========== 3. 合并重叠区域 ==========
        if regions:
            regions = self._merge_regions(regions, w, h)
        # 限制总覆盖面积不超过30%
        total_area = sum((x2 - x1) * (y2 - y1) for x1, y1, x2, y2 in regions)
        if total_area > w * h * 0.30:
            logger.warning(f"Auto-detect regions too large ({total_area / (w * h) * 100:.1f}%), filtering...")
            # 按面积排序，保留小的（水印通常小）
            regions.sort(key=lambda r: (r[2] - r[0]) * (r[3] - r[1]))
            filtered = []
            cur_area = 0
            for r in regions:
                a = (r[2] - r[0]) * (r[3] - r[1])
                if cur_area + a <= w * h * 0.30:
                    filtered.append(r)
                    cur_area += a
            regions = filtered
        logger.info(f"Auto-detected {len(regions)} watermark regions")
        return regions
    def _blend_inpaint(self, original: np.ndarray, inpainted: np.ndarray,
                       mask: np.ndarray) -> np.ndarray:
        """
        高质量融合：只替换mask区域，保留原图其他部分。
        关键：确保inpainted尺寸与原图一致（LaMa可能改变尺寸）
        """
        # 确保尺寸一致
        if inpainted.shape[:2] != original.shape[:2]:
            logger.info(f"Resizing inpainted from {inpainted.shape[:2]} to {original.shape[:2]}")
            inpainted = cv2.resize(inpainted, (original.shape[1], original.shape[0]),
                                   interpolation=cv2.INTER_LINEAR)
        # 确保mask尺寸一致
        if mask.shape[:2] != original.shape[:2]:
            mask = cv2.resize(mask, (original.shape[1], original.shape[0]),
                              interpolation=cv2.INTER_NEAREST)
        # 二值化mask
        mask_bin = (mask > 127).astype(np.float32)
        # 对mask边缘做轻微高斯模糊，实现柔和过渡（只影响边缘几个像素）
        kernel_size = 5
        mask_soft = cv2.GaussianBlur(mask_bin, (kernel_size, kernel_size), 0)
        # 扩展为3通道
        mask_3ch = np.stack([mask_soft, mask_soft, mask_soft], axis=2)
        # 融合
        final = inpainted.astype(np.float32) * mask_3ch + original.astype(np.float32) * (1 - mask_3ch)
        return np.clip(final, 0, 255).astype(np.uint8)
    def inpaint_image(self,
                      image_path: str,
                      output_path: Optional[str] = None,
                      mask_path: Optional[str] = None,
                      bboxes: Optional[List[Tuple[int, int, int, int]]] = None,
                      auto_detect: bool = False,
                      feather: int = 5) -> str:
        """修复单张图片的水印 - 只修复mask区域，保留原图其他部分"""
        self._ensure_model_loaded()
        logger.info(f"Processing image: {image_path}")
        start_time = time.time()
        image = self._load_image(image_path)
        h, w = image.shape[:2]
        # 生成mask
        if mask_path and os.path.exists(mask_path):
            logger.info(f"Using pre-generated mask: {mask_path}")
            mask = self._load_image(mask_path)
            if len(mask.shape) == 3:
                mask = cv2.cvtColor(mask, cv2.COLOR_RGB2GRAY)
            _, mask = cv2.threshold(mask, 127, 255, cv2.THRESH_BINARY)
        else:
            mask = np.zeros((h, w), dtype=np.uint8)
            if bboxes:
                for bbox in bboxes:
                    region_mask = self._create_mask_from_bbox((h, w), bbox, feather)
                    mask = cv2.bitwise_or(mask, region_mask)
            if auto_detect:
                detected = self._detect_watermark_auto(image)
                for bbox in detected:
                    region_mask = self._create_mask_from_bbox((h, w), bbox, feather)
                    mask = cv2.bitwise_or(mask, region_mask)
        # 检查mask是否为空
        if np.sum(mask) == 0:
            logger.warning("Mask is empty, no regions to inpaint. Returning original.")
            if output_path is None:
                output_path = str(OUTPUT_DIR / f"result_{Path(image_path).stem}.png")
            self._save_image(image, output_path)
            return output_path
        # 使用LaMa修复
        logger.info("Running LaMa inpainting...")
        try:
            pil_image = Image.fromarray(image.astype(np.uint8))
            pil_mask = Image.fromarray(mask.astype(np.uint8))
            result = self.model(pil_image, pil_mask)
            result_np = np.array(result)
            # 只替换mask区域，保留原图其他部分（内部会处理尺寸对齐）
            final_np = self._blend_inpaint(image, result_np, mask)
        except Exception as e:
            logger.error(f"LaMa failed: {e}, falling back to cv2.inpaint")
            mask_binary = (mask > 127).astype(np.uint8) * 255
            inpainted = cv2.inpaint(
                cv2.cvtColor(image, cv2.COLOR_RGB2BGR),
                mask_binary,
                inpaintRadius=5,
                flags=cv2.INPAINT_TELEA
            )
            inpainted_rgb = cv2.cvtColor(inpainted, cv2.COLOR_BGR2RGB)
            final_np = self._blend_inpaint(image, inpainted_rgb, mask)
        # 保存结果
        if output_path is None:
            output_path = str(OUTPUT_DIR / f"result_{Path(image_path).stem}.png")
        self._save_image(final_np, output_path)
        elapsed = time.time() - start_time
        logger.info(f"[DONE] Image saved: {output_path} ({elapsed:.1f}s)")
        return output_path
    def inpaint_video(self,
                      video_path: str,
                      output_path: Optional[str] = None,
                      bboxes: Optional[List[Tuple[int, int, int, int]]] = None,
                      auto_detect: bool = False,
                      start_frame: int = 0,
                      end_frame: Optional[int] = None,
                      progress_callback=None) -> str:
        """修复视频中的水印（逐帧处理）"""
        self._ensure_model_loaded()
        logger.info(f"Processing video: {video_path}")
        start_time = time.time()
        cap = cv2.VideoCapture(video_path)
        if not cap.isOpened():
            raise ValueError(f"Cannot open video: {video_path}")
        fps = cap.get(cv2.CAP_PROP_FPS)
        if fps <= 0 or fps > 120:
            fps = 30.0  # 兜底
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        if end_frame is None:
            end_frame = total_frames
        logger.info(f"Video: {width}x{height}, {fps}fps, {total_frames} frames")
        logger.info(f"Processing frames {start_frame}-{end_frame}")
        if output_path is None:
            output_path = str(OUTPUT_DIR / f"result_{Path(video_path).stem}.mp4")
        # 使用可靠的视频编码器 - MP4V是OpenCV内置最兼容的
        codecs_to_try = [
            ('mp4v', '.mp4'),   # MPEG-4 (最兼容)
            ('avc1', '.mp4'),   # H.264
            ('X264', '.mp4'),
            ('H264', '.mp4'),
            ('MJPG', '.avi'),
        ]
        writer = None
        final_output = output_path
        for codec, ext in codecs_to_try:
            try:
                fourcc = cv2.VideoWriter_fourcc(*codec)
                test_path = str(Path(output_path).with_suffix(ext))
                test_writer = cv2.VideoWriter(test_path, fourcc, fps, (width, height))
                if test_writer.isOpened():
                    writer = test_writer
                    final_output = test_path
                    logger.info(f"Using codec: {codec} -> {test_path}")
                    break
                else:
                    test_writer.release()
            except Exception as e:
                logger.warning(f"Codec {codec} failed: {e}")
                continue
        if writer is None:
            raise RuntimeError("Cannot create video writer with any available codec")
        first_frame_mask = None
        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame)
        frame_idx = start_frame
        while frame_idx < end_frame:
            ret, frame = cap.read()
            if not ret:
                break
            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            if first_frame_mask is None:
                mask = np.zeros((height, width), dtype=np.uint8)
                if bboxes:
                    for bbox in bboxes:
                        region_mask = self._create_mask_from_bbox((height, width), bbox)
                        mask = cv2.bitwise_or(mask, region_mask)
                if auto_detect:
                    detected = self._detect_watermark_auto(frame_rgb)
                    for bbox in detected:
                        region_mask = self._create_mask_from_bbox((height, width), bbox)
                        mask = cv2.bitwise_or(mask, region_mask)
                if np.sum(mask) > 0:
                    first_frame_mask = mask
                    logger.info(f"Watermark mask created, {np.sum(mask > 0)} pixels")
                else:
                    writer.write(frame)
                    frame_idx += 1
                    continue
            try:
                pil_frame = Image.fromarray(frame_rgb.astype(np.uint8))
                pil_mask = Image.fromarray(first_frame_mask.astype(np.uint8))
                result = self.model(pil_frame, pil_mask)
                result_np = np.array(result)
                # 只替换mask区域，保留原帧其他部分（内部会处理尺寸对齐）
                final_np = self._blend_inpaint(frame_rgb, result_np, first_frame_mask)
                final_bgr = cv2.cvtColor(final_np, cv2.COLOR_RGB2BGR)
                writer.write(final_bgr)
            except Exception as e:
                logger.error(f"Frame {frame_idx} failed: {e}")
                writer.write(frame)
            frame_idx += 1
            if progress_callback:
                progress = (frame_idx - start_frame) / (end_frame - start_frame) * 100
                progress_callback(progress)
            if frame_idx % 30 == 0:
                logger.info(f"Progress: {frame_idx}/{end_frame} frames")
        cap.release()
        writer.release()
        # 验证输出文件
        if os.path.exists(final_output):
            file_size = os.path.getsize(final_output)
            logger.info(f"Output file size: {file_size / 1024:.1f}KB")
            if file_size < 1024:
                logger.warning("Output file is too small, might be corrupted!")
        elapsed = time.time() - start_time
        logger.info(f"[DONE] Video saved: {final_output} ({elapsed:.1f}s)")
        return final_output
# 全局引擎实例
_engine_instance = None
def get_engine(device: str = 'auto') -> InpaintingEngine:
    """获取全局引擎实例（单例）"""
    global _engine_instance
    if _engine_instance is None:
        logger.info("Creating new engine instance...")
        _engine_instance = InpaintingEngine(device=device)
        success = _engine_instance.load_model()
        if not success:
            logger.error("Failed to load inpainting model!")
            raise RuntimeError(
                "Cannot load LaMa inpainting model. "
                "Please check your network connection. "
                "The model will be downloaded automatically on first run. "
                "If the problem persists, try running: pip install simple-lama-inpainting"
            )
    return _engine_instance